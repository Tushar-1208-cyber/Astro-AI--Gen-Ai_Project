# ==========================================
# Astro AI - Environment Configuration Example
# ==========================================

# ------------------------------------------
# 1. MongoDB Production Configuration
# ------------------------------------------
# Connection String:
# - Host Development: mongodb://localhost:27017/astro
# - Production with Auth: mongodb://<user>:<password>@localhost:27017/astro?authSource=admin
# - Docker Compose internal: mongodb://<user>:<password>@mongodb:27017/astro?authSource=admin
MONGODB_URI=mongodb://localhost:27017/astro

# Mandatory MongoDB Docker Authentication Credentials (required by docker-compose.yml)
# docker compose up will fail safely if these are empty or unset.
MONGO_INITDB_ROOT_USERNAME=astro_admin
MONGO_INITDB_ROOT_PASSWORD=your_strong_mongo_root_password_here_min_16_chars
MONGO_DATABASE=astro

# MongoDB Production Backup & Restore Procedures:
# Backup:
#   docker exec astro-mongodb mongodump -u $MONGO_INITDB_ROOT_USERNAME -p $MONGO_INITDB_ROOT_PASSWORD --authenticationDatabase admin --db astro --gzip --archive=/data/db/astro_backup_$(date +%Y%m%d).gz
# Restore:
#   docker exec -i astro-mongodb mongorestore -u $MONGO_INITDB_ROOT_USERNAME -p $MONGO_INITDB_ROOT_PASSWORD --authenticationDatabase admin --db astro --gzip --archive=/data/db/astro_backup_$(date +%Y%m%d).gz

# ------------------------------------------
# 2. Authentication & Security Secrets
# ------------------------------------------
# JWT Secret Key for Session Authentication (Mandatory: min 32 chars, required by docker-compose)
# Generate using: openssl rand -base64 64
# Or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_long

# Node Environment ('development' | 'production')
NODE_ENV=production

# Application Port
PORT=9002

# Allowed CORS origins for Local AI inference server (comma-separated, no wildcard allowed)
ALLOWED_ORIGINS=http://localhost:9002,http://app:9002

# ------------------------------------------
# 3. AI Provider Configuration (Phase 3.2 Hybrid Architecture)
# ------------------------------------------
# Active AI provider selection: 'local' (default, local-first) | 'gemini' | 'auto'
AI_PROVIDER=local

# Local AI Server URL (FastAPI TinyLlama-1.1B server)
# Default for host development: http://localhost:8000
# Default inside docker: http://local-ai:8000/generate
LOCAL_AI_URL=http://localhost:8000

# Google GenAI / Gemini API Key (Optional cloud provider)
# If provided, enables cloud capabilities (Gemini 2.0 Flash, Multimodal Vision, Audio TTS)
# Get from: https://aistudio.google.com/
GOOGLE_GENAI_API_KEY=

# ------------------------------------------
# 4. RAG & Vector Embeddings Configuration
# ------------------------------------------
# Set to 'true' to use Google text-embedding-004 (768-d). Default is 'false' (deterministic-ngram-384).
USE_CLOUD_EMBEDDINGS=false

# Explicit Fallback Choice:
# If 'false' (default), cloud embedding failures throw explicit errors to prevent vector space corruption.
# If 'true', explicitly allows fallback to local 384-d semantic vectorizer.
ALLOW_CLOUD_EMBEDDING_FALLBACK=false

# ------------------------------------------
# 5. Optional Services
# ------------------------------------------
# Ollama Configuration (Optional fallback, leave disabled if not installed)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_ENABLED=false
