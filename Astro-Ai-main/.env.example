# ==========================================
# Astro AI - Environment Configuration Example
# ==========================================

# MongoDB Connection String
# Example: mongodb://localhost:27017/astro or mongodb+srv://<user>:<password>@cluster.mongodb.net/astro
MONGODB_URI=mongodb://localhost:27017/astro

# JWT Secret Key for Session Authentication (Must be a strong random secret in production, min 32 chars)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_long

# Node Environment ('development' | 'production')
NODE_ENV=development

# ==========================================
# AI Provider Configuration (Phase 3.2 Hybrid Architecture)
# ==========================================
# Active AI provider selection: 'local' (default, local-first) | 'gemini' | 'auto'
AI_PROVIDER=local

# Local AI Server URL (FastAPI TinyLlama-1.1B server)
# Default: http://localhost:8000
LOCAL_AI_URL=http://localhost:8000

# Google GenAI / Gemini API Key (Optional cloud provider)
# If provided, enables cloud capabilities (Gemini 2.0 Flash, Vision, Audio)
# Get from: https://aistudio.google.com/
GOOGLE_GENAI_API_KEY=

# Ollama Configuration (Optional fallback, leave disabled if not installed)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_ENABLED=false
