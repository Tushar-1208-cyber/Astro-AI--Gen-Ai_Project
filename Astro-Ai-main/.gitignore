# ==========================================
# Astro AI - Git Ignore Policy
# ==========================================

# Environment variables & secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
firebase-service-account.json

# Always allow environment template
!.env.example

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js and frontend builds
.next/
out/
build/
dist/

# Python virtual environments & compiled bytecode
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so

# Local database files & runtime stores
local_db.json
astro_ai_local_db*.json
backups/
uploads/
*.db
*.sqlite
*.sqlite3

# Operating System & Editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
.turbo/
.idea/
.vscode/
